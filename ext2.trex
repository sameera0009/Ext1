<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.github.modern.donut" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Futuristic Donut Chart</description>
    <author name="YourName" email="you@example.com" organization="YourOrg" website="https://github.com/sameera0009"/>
    <min-api-version>1.1</min-api-version>
    
    <source-location>
      <url>https://sameera0009.github.io/Ext1/</url>
    </source-location>
    
    <icon/>

    <permissions>
      <permission>full data</permission>
    </permissions>

    <encoding id="angle">
      <display-name>Arc Size</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-a" />
    </encoding>

    <encoding id="color">
      <display-name>Categories</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="color" />
    </encoding>

  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Modern Neon Donut</text>
    </resource>
  </resources>
</manifest>